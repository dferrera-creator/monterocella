APP_NAME="Monte Rocella"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Mazatlan
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=monterocella
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file

QUEUE_CONNECTION=sync

MAIL_MAILER=log

# ─── Monte Rocella ─────────────────────────────────────────────────────────
WHATSAPP_NUMBER="+52-624-000-0000"

# Analytics (fill in when credentials are available)
GTM_ID=
GA4_MEASUREMENT_ID=
HUBSPOT_PORTAL_ID=
CLARITY_PROJECT_ID=

# Booking engine: 'mock' for development, 'guesty' for production
VITE_BOOKING_ENGINE=mock
GUESTY_WIDGET_ID=IO312PWQ
GUESTY_SITE_URL=delmar-monterocella.guestybookings.com

# Currency conversion (Banxico API)
BANXICO_API_KEY=

# Minimum stay
MIN_STAY_NIGHTS=2
